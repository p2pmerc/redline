# Copy to .env for local work. Real values are never committed.

# --- Server (server/) ---
PORT=8791
# Where the JSON store is kept. On Railway, mount a volume here.
DATA_DIR=./.data
# Privy app id (public).
PRIVY_APP_ID=cmw091k5e006v0glbrx3ouzry
# "preview": the server runs the escrow state machine and no funds move.
# "testnet": reserved for the deployed contract and enclave.
LEDGER_MODE=preview
# Needed only when LEDGER_MODE=testnet.
ESCROW_CONTRACT_ID=
ENCLAVE_PUBLIC_KEY=
# Optional: raises the GitHub rate limit for merge lookups in preview mode.
GITHUB_TOKEN=
# Optional: extra origin allowed to call the API.
ALLOWED_ORIGIN=

# --- Web (web/, read at build time, all public) ---
VITE_PRIVY_APP_ID=cmw091k5e006v0glbrx3ouzry
# Empty means preview mode: report keys stay in the browser and are not sealed to an enclave.
VITE_ENCLAVE_PUBLIC_KEY=
VITE_ESCROW_CONTRACT_ID=
VITE_API_BASE=/api
